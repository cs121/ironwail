  "command.catalog.v1": "{\"common.goBack\":{\"title\":\"Zurück\",\"category\":\"Ansicht\",\"keybind\":\"mod+[\"},\"common.goForward\":{\"title\":\"Vorwärts navigieren\",\"category\":\"Ansicht\",\"keybind\":\"mod+]\"},\"sidebar.toggle\":{\"title\":\"Seitenleiste umschalten\",\"category\":\"Ansicht\",\"keybind\":\"mod+b\"},\"project.open\":{\"title\":\"Projekt öffnen\",\"category\":\"Projekt\",\"keybind\":\"mod+o\"},\"project.previous\":{\"title\":\"Previous project\",\"category\":\"Projekt\",\"keybind\":\"mod+alt+arrowup\"},\"project.next\":{\"title\":\"Next project\",\"category\":\"Projekt\",\"keybind\":\"mod+alt+arrowdown\"},\"provider.connect\":{\"title\":\"Anbieter verbinden\",\"category\":\"Anbieter\"},\"server.switch\":{\"title\":\"Server wechseln\",\"category\":\"Server\"},\"settings.open\":{\"title\":\"Einstellungen öffnen\",\"category\":\"Einstellungen\",\"keybind\":\"mod+comma\"},\"session.previous\":{\"title\":\"Vorherige Sitzung\",\"category\":\"Sitzung\",\"keybind\":\"alt+arrowup\"},\"session.next\":{\"title\":\"Nächste Sitzung\",\"category\":\"Sitzung\",\"keybind\":\"alt+arrowdown\"},\"session.previous.unseen\":{\"title\":\"Vorherige ungelesene Sitzung\",\"category\":\"Sitzung\",\"keybind\":\"shift+alt+arrowup\"},\"session.next.unseen\":{\"title\":\"Nächste ungelesene Sitzung\",\"category\":\"Sitzung\",\"keybind\":\"shift+alt+arrowdown\"},\"session.archive\":{\"title\":\"Sitzung archivieren\",\"category\":\"Sitzung\",\"keybind\":\"mod+shift+backspace\"},\"workspace.new\":{\"title\":\"Neuer Arbeitsbereich\",\"category\":\"Arbeitsbereich\",\"keybind\":\"mod+shift+w\"},\"workspace.toggle\":{\"title\":\"Arbeitsbereiche umschalten\",\"description\":\"Mehrere Arbeitsbereiche in der Seitenleiste aktivieren oder deaktivieren\",\"category\":\"Arbeitsbereich\",\"slash\":\"workspace\"},\"theme.cycle\":{\"title\":\"Thema wechseln\",\"category\":\"Thema\",\"keybind\":\"mod+shift+t\"},\"theme.set.amoled\":{\"title\":\"Thema verwenden: AMOLED\",\"category\":\"Thema\"