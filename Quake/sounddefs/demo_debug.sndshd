// Demo/debug sound definitions that collectively exercise every authored
// property supported by the sound-def parser and runtime.
//
// Suggested console flow:
//   snd_reload_defs
//   snd_list_defs
//   snd_print_def debug/spatial_kitchen_sink
//   snd_play_def debug/ui_cycle
//   snd_play_def debug/spatial_kitchen_sink 384 -2400
//   snd_play_def debug/ambient_loop 512
//   snd_play_def debug/music_loop

sound debug/ui_cycle
{
	priority 240
	max_instances 4
	spatialize false
	doppler false
	lowpass_by_distance false
	reverb_send 0.05

	sample misc/menu1.wav
	sample misc/menu2.wav
	sample misc/menu3.wav
	bus ui
	volume 0.80
	volume_random 0.70 1.00
	pitch 1.00
	pitch_random 0.92 1.10
	loop false
	chance 1.00
	delay_ms 0
	start_offset_ms 0
}

sound debug/spatial_kitchen_sink
{
	priority 208
	max_instances 1
	spatialize true
	doppler true
	lowpass_by_distance true
	reverb_send 0.70

	layer
	{
		sample weapons/rocket1i.wav
		sample weapons/grenade.wav
		bus sfx
		volume 1.00
		volume_random 0.85 1.15
		pitch 0.95
		pitch_random 0.85 1.05
		loop false
		chance 1.00
		delay_ms 0
		start_offset_ms 0
	}

	layer
	{
		sample ambience/thunder1.wav
		bus ambient
		volume 0.30
		volume_random 1.00 1.00
		pitch 0.75
		pitch_random 1.00 1.00
		loop false
		chance 0.65
		delay_ms 120
		start_offset_ms 180
	}
}

sound debug/ambient_loop
{
	priority 80
	max_instances 1
	spatialize true
	doppler false
	lowpass_by_distance true
	reverb_send 0.35

	layer
	{
		sample ambience/drone6.wav
		bus ambient
		volume 0.55
		volume_random 1.00 1.00
		pitch 0.85
		pitch_random 0.98 1.02
		loop true
		chance 1.00
		delay_ms 0
		start_offset_ms 250
	}
}

sound debug/music_loop
{
	priority 64
	max_instances 1
	spatialize false
	doppler false
	lowpass_by_distance false
	reverb_send 0.00

	layer
	{
		sample ambience/comp1.wav
		bus music
		volume 0.65
		volume_random 1.00 1.00
		pitch 0.70
		pitch_random 1.00 1.00
		loop true
		chance 1.00
		delay_ms 0
		start_offset_ms 120
	}
}
