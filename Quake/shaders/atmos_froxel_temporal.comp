#version 430
layout(local_size_x=4, local_size_y=4, local_size_z=4) in;
layout(binding=10) uniform sampler3D HistoryScatter;
layout(rgba16f, binding=0) readonly uniform image3D CurrentScatter;
layout(rgba16f, binding=1) writeonly uniform image3D OutResolved;
layout(rgba16f, binding=2) writeonly uniform image3D OutHistory;
layout(location=0) uniform vec4 FroxelDims;
layout(location=1) uniform vec4 TemporalParams; // x history weight, y prev valid

void main()
{
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(coord, ivec3(FroxelDims.xyz))))
        return;

    vec3 uvw = (vec3(coord) + vec3(0.5)) / max(FroxelDims.xyz, vec3(1.0));
    vec4 current = imageLoad(CurrentScatter, coord);
    vec4 history = texture(HistoryScatter, uvw);

    vec3 minC = current.rgb;
    vec3 maxC = current.rgb;
    for (int z = -1; z <= 1; ++z)
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        ivec3 nc = clamp(coord + ivec3(x,y,z), ivec3(0), ivec3(FroxelDims.xyz) - ivec3(1));
        vec3 c = imageLoad(CurrentScatter, nc).rgb;
        minC = min(minC, c);
        maxC = max(maxC, c);
    }

    history.rgb = clamp(history.rgb, minC, maxC);
    float wTarget = (TemporalParams.z > 0.0) ? TemporalParams.z : TemporalParams.x;
    float w = (TemporalParams.y > 0.5) ? clamp(wTarget, 0.0, 0.99) : 0.0;
    vec4 outv = mix(current, history, w);
    imageStore(OutResolved, coord, outv);
    imageStore(OutHistory, coord, outv);
}
