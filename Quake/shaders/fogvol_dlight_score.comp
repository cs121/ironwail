layout(local_size_x=64) in;

struct FogDlightCandidate
{
	vec4 pos_rad;       // xyz position, w radius
	vec4 color_bias;    // rgb color, w score bias
	uvec4 meta;         // x flags(bit0 inject), y stable id
};

layout(std430, binding=0) readonly buffer CandidateBuffer
{
	FogDlightCandidate candidates[];
};

layout(std430, binding=1) writeonly buffer SortEntryBuffer
{
	uvec4 entries[]; // x score key (desc), y stable id, z candidate index, w reserved
};

layout(location=0) uniform vec4 ScoreParams0; // xyz vieworg, w candidate_count

uint FloatSortableAsc(float v)
{
	uint f = floatBitsToUint(v);
	return ((f & 0x80000000u) != 0u) ? ~f : (f ^ 0x80000000u);
}

uint FloatSortableDesc(float v)
{
	return ~FloatSortableAsc(v);
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint count = uint(max(ScoreParams0.w, 0.0));
	if (i >= entries.length())
		return;

	if (i >= count)
	{
		entries[i] = uvec4(0xffffffffu, 0xffffffffu, i, 0u);
		return;
	}

	FogDlightCandidate c = candidates[i];
	uint flags = c.meta.x;
	float radius = c.pos_rad.w;
	float intensity = max(c.color_bias.x, max(c.color_bias.y, c.color_bias.z));
	float score = 0.0;
	uint key = 0xffffffffu;

	if ((flags & 1u) != 0u && radius > 0.0 && intensity > 0.0)
	{
		vec3 to_light = c.pos_rad.xyz - ScoreParams0.xyz;
		float dist = length(to_light);
		score = radius * intensity * c.color_bias.w;
		score *= 1.0 / (1.0 + 0.0025 * dist);
		if (score > 0.0)
			key = FloatSortableDesc(score);
	}

	entries[i] = uvec4(key, c.meta.y, i, 0u);
}
