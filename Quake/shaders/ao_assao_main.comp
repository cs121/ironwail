layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D DepthTexture;
layout(binding=1) uniform sampler2D DepthPrefilter;
layout(r16f, binding=0) uniform writeonly image2D OutAO;
layout(rg8, binding=1) uniform writeonly image2D OutEdges;
layout(rg16f, binding=2) uniform writeonly image2D OutBent;
layout(location=0) uniform mat4 u_invProj;
layout(location=1) uniform vec4 u_screen;
layout(location=2) uniform vec4 u_ao;
layout(location=3) uniform vec4 u_misc;
layout(location=4) uniform vec4 u_viewRect;
layout(location=5) uniform vec4 u_depth;
layout(location=6) uniform vec4 u_quality;
#include "ao_common.glsl"
void main(){
        ivec2 px=ivec2(gl_GlobalInvocationID.xy); ivec2 size=imageSize(OutAO); if(any(greaterThanEqual(px,size))) return;
        vec2 uv=(vec2(px)+0.5)/vec2(size);
        vec2 suv = mix(u_viewRect.xy, u_viewRect.zw, uv);
        float d=texelFetch(DepthTexture, ivec2(suv*u_screen.zw),0).r;
        vec3 p=AO_ReconstructViewPos(u_invProj,suv,d,u_depth.z);
        vec3 n=AO_ReconstructNormalFromDepth(DepthTexture,u_invProj,ivec2(suv*u_screen.zw),u_screen.xy,u_depth.z);
        int taps=int(u_quality.x);
        float occ=0.0;
        vec3 bent=vec3(0.0);
        for(int i=0;i<taps;i++){
                float fi=float(i)+AO_Hash12(vec2(px)+u_ao.w);
                float ang=6.2831853*fi/float(max(taps,1));
                float rad=(0.35+0.65*fi/float(max(taps,1)))*u_ao.x;
                vec2 off=vec2(cos(ang),sin(ang))*rad*0.0015;
                vec2 suv2=clamp(suv+off,u_viewRect.xy,u_viewRect.zw);
                float sd=textureLod(DepthTexture,suv2,0.0).r;
                vec3 sp=AO_ReconstructViewPos(u_invProj,suv2,sd,u_depth.z);
                vec3 v=sp-p;
                float dist=max(length(v),1e-4);
                vec3 dir=v/dist;
                float nd=max(dot(n,dir),0.0);
                float thick=smoothstep(u_ao.x*1.5,0.0,dist);
                float h=max(0.0, nd-0.03);
                float o=h*thick;
                occ += o;
                bent += (1.0-o) * (-dir);
        }
        float ao=1.0-occ/float(max(taps,1));
        ao=clamp(ao,0.0,1.0);
        imageStore(OutAO,px,vec4(ao));
        ivec2 dpx = ivec2(suv * u_screen.zw);
        ivec2 depthSize = textureSize(DepthTexture, 0);
        ivec2 pxR = clamp(dpx + ivec2(1, 0), ivec2(0), depthSize - ivec2(1));
        ivec2 pxU = clamp(dpx + ivec2(0, 1), ivec2(0), depthSize - ivec2(1));
        float dR = texelFetch(DepthTexture, pxR, 0).r;
        float dU = texelFetch(DepthTexture, pxU, 0).r;
        float edge = length(vec2(dR - d, dU - d)) * 32.0;
        imageStore(OutEdges,px,vec4(clamp(edge,0.0,1.0),ao,0,0));
        if (u_quality.w > 0.5)
        {
                vec2 b=normalize(bent).yz;
                if (any(isnan(b)) || any(isinf(b)))
                        b = vec2(0.0, 0.0);
                imageStore(OutBent,px,vec4(b*0.5+0.5,0,1));
        }
}
