// ASSAO (Adaptive Screen Space Ambient Occlusion) Main Pass
// Fixes:
//  - BUG: normalize(bent).yz → normalize(bent).xy  (bent normal is XYZ; YZ was wrong)
//  - BUG: smoothstep(u_ao.x*1.5, 0.0, dist) → smoothstep(0.0, u_ao.x*1.5, dist)
//         (arguments were swapped; always returned 0, killing all thickness-based falloff)
//  - Eliminated double computation of ivec2(suv * u_screen.zw) by caching as dpx.
//  - Clamped taps to avoid division by zero safely.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D DepthTexture;
layout(binding = 1) uniform sampler2D DepthPrefilter;  // unused in ASSAO but kept for API symmetry

layout(r16f,   binding = 0) uniform writeonly image2D OutAO;
layout(rg8,    binding = 1) uniform writeonly image2D OutEdges;
layout(rg16f,  binding = 2) uniform writeonly image2D OutBent;

layout(location = 0) uniform mat4 u_invProj;
layout(location = 1) uniform vec4 u_screen;   // xy=invSize, zw=size
layout(location = 2) uniform vec4 u_ao;       // x=radius(world), y=falloffStart, z=intensity, w=noiseOffset
layout(location = 3) uniform vec4 u_misc;
layout(location = 4) uniform vec4 u_viewRect; // xy=uvMin, zw=uvMax
layout(location = 5) uniform vec4 u_depth;    // x=near, y=far, z=reversedZ, w=unused
layout(location = 6) uniform vec4 u_quality;  // x=taps, y=slices(unused), z=steps(unused), w=bentEnable

#include "ao_common.glsl"

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(OutAO);
    if (any(greaterThanEqual(px, size))) return;

    vec2 uv  = (vec2(px) + 0.5) / vec2(size);
    vec2 suv = mix(u_viewRect.xy, u_viewRect.zw, uv);

    // Cache the full-res source pixel once
    ivec2 dpx = ivec2(suv * u_screen.zw);

    float d = texelFetch(DepthTexture, dpx, 0).r;

    // Early-out on sky
    float skyDepth = (u_depth.z > 0.5) ? 0.0 : 1.0;
    if (abs(d - skyDepth) < 1e-5)
    {
        imageStore(OutAO,    px, vec4(1.0));
        imageStore(OutEdges, px, vec4(0.0));
        if (u_quality.w > 0.5)
            imageStore(OutBent, px, vec4(0.5, 0.5, 0.0, 1.0));
        return;
    }

    vec3 p = AO_ReconstructViewPos(u_invProj, suv, d, u_depth.z);
    vec3 n = AO_ReconstructNormalFromDepth(DepthTexture, u_invProj, dpx, u_screen.xy, u_depth.z);

    int   taps = max(int(u_quality.x), 1);
    float ftaps = float(taps);

    float occ  = 0.0;
    vec3  bent = vec3(0.0);
    float jitter = AO_Hash12(vec2(px) + u_ao.w);

    for (int i = 0; i < taps; i++)
    {
        float fi  = float(i) + jitter;
        float ang = 6.2831853 * fi / ftaps;
        // Radius scales from 35% to 100% of u_ao.x (world-space radius)
        float rad = (0.35 + 0.65 * float(i) / ftaps) * u_ao.x;
        vec2  off = vec2(cos(ang), sin(ang)) * rad * 0.0015;

        vec2  suv2 = clamp(suv + off, u_viewRect.xy, u_viewRect.zw);
        float sd   = textureLod(DepthTexture, suv2, 0.0).r;
        vec3  sp   = AO_ReconstructViewPos(u_invProj, suv2, sd, u_depth.z);

        vec3  v    = sp - p;
        float dist = max(length(v), 1e-4);
        vec3  dir  = v / dist;

        float nd = max(dot(n, dir), 0.0);

        // BUG FIX: smoothstep arguments were swapped (edge0 must be < edge1)
        // Old: smoothstep(u_ao.x*1.5, 0.0, dist) → always 0 when u_ao.x > 0
        // New: smoothstep(0.0, u_ao.x*1.5, dist) → correct falloff
        float thick = 1.0 - smoothstep(0.0, u_ao.x * 1.5, dist);

        float h = max(0.0, nd - 0.03); // small bias to avoid self-occlusion
        float o = h * thick;

        occ  += o;
        bent += (1.0 - o) * (-dir);
    }

    float ao = clamp(1.0 - occ / ftaps, 0.0, 1.0);
    ao = pow(ao, max(u_ao.z, 0.01)); // intensity curve

    imageStore(OutAO, px, vec4(ao));

    // --- Edge detection ---
    ivec2 depthSize = textureSize(DepthTexture, 0);
    float dR = texelFetch(DepthTexture, clamp(dpx + ivec2(1, 0), ivec2(0), depthSize - ivec2(1)), 0).r;
    float dU = texelFetch(DepthTexture, clamp(dpx + ivec2(0, 1), ivec2(0), depthSize - ivec2(1)), 0).r;
    float edge = clamp(length(vec2(dR - d, dU - d)) * 32.0, 0.0, 1.0);
    imageStore(OutEdges, px, vec4(edge, ao, 0.0, 0.0));

    // --- Bent Normal ---
    if (u_quality.w > 0.5)
    {
        // BUG FIX: was .yz (wrong), should be .xy
        vec2 b = normalize(bent).xy;
        if (any(isnan(b)) || any(isinf(b)))
            b = vec2(0.0);
        imageStore(OutBent, px, vec4(b * 0.5 + 0.5, 0.0, 1.0));
    }
}
