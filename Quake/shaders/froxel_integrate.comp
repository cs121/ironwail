layout(local_size_x=8, local_size_y=8, local_size_z=1) in;

layout(binding=0) uniform sampler3D FogFroxelLightTex;
layout(rgba16f, binding=0) uniform image2D FogFroxelIntegratedTex;

layout(location=0) uniform vec4 FogIntegrateSize; // xy = output size

void main()
{
	ivec2 outSize = max(ivec2(FogIntegrateSize.xy), ivec2(1));
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(coord, outSize)))
		return;

	vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(outSize);
	vec3 accum = vec3(0.0);
	const int steps = 16;
	for (int i = 0; i < steps; ++i)
	{
		float z = (float(i) + 0.5) / float(steps);
		accum += texture(FogFroxelLightTex, vec3(uv, z)).rgb;
	}
	accum *= (1.0 / float(steps));
	imageStore(FogFroxelIntegratedTex, coord, vec4(accum, 1.0));
}
