layout(local_size_x=64) in;

layout(std430, binding=0) buffer SortEntryBuffer
{
	uvec4 entries[]; // lexicographic sort by x, then y, then z, then w (ascending)
};

layout(location=0) uniform vec4 SortParams; // x count, y j, z k

int CompareEntries(uvec4 a, uvec4 b)
{
	if (a.x < b.x) return -1;
	if (a.x > b.x) return 1;
	if (a.y < b.y) return -1;
	if (a.y > b.y) return 1;
	if (a.z < b.z) return -1;
	if (a.z > b.z) return 1;
	if (a.w < b.w) return -1;
	if (a.w > b.w) return 1;
	return 0;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint count = uint(max(SortParams.x, 0.0));
	uint j = uint(max(SortParams.y, 0.0));
	uint k = uint(max(SortParams.z, 0.0));
	uint ixj = i ^ j;

	if (i >= count || ixj >= count || ixj <= i)
		return;

	uvec4 a = entries[i];
	uvec4 b = entries[ixj];
	bool up = ((i & k) == 0u);
	int cmp = CompareEntries(a, b);

	if ((cmp > 0 && up) || (cmp < 0 && !up))
	{
		entries[i] = b;
		entries[ixj] = a;
	}
}
