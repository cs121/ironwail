# Ironwail Quake (id1) — Base Pack Shader File
# Coverage: common liquids, lights, teleporter, torches, simple metal glow.
# Notes:
# - If your WAD uses different base names (e.g., WATER vs WATER1), duplicate and rename blocks.
# - For +0/+1 animated sequences, ensure all frames exist; adjust fps as desired.
# - Emissive stages render additively and bypass lightmap modulation.

# ----------------------
# WATER (star-prefixed)
# ----------------------
shader *water1
{
    sort additive
    stage {
        animmap 6 *water1 *water2 *water3 *water4
        tcmod scroll 0.02 0.00
        tcmod stretch sin 1 0.08 0 0.4
        tcmod turb 0.025 0.6
        rgbgen const 0.5 0.7 1.0
        blend add
        emissive 1
    }
}

shader *water2 { stage { map *water2 } }
shader *water3 { stage { map *water3 } }
shader *water4 { stage { map *water4 } }

# ----------------------
# SLIME (star-prefixed)
# ----------------------
shader *slime1
{
    sort additive
    stage {
        animmap 6 *slime1 *slime2 *slime3 *slime4
        tcmod scroll 0.015 0.0
        tcmod stretch sin 1 0.06 0 0.35
        tcmod turb 0.02 0.55
        rgbgen const 0.4 1.0 0.4
        blend add
        emissive 1
    }
}

shader *slime2 { stage { map *slime2 } }
shader *slime3 { stage { map *slime3 } }
shader *slime4 { stage { map *slime4 } }

# ----------------------
# LAVA (star-prefixed)
# ----------------------
shader *lava1
{
    sort additive
    stage {
        animmap 8 *lava1 *lava2 *lava3 *lava4
        tcmod scroll 0.01 0.0
        rgbgen const 1.0 0.5 0.2
        blend add
        emissive 1
    }
}

shader *lava2 { stage { map *lava2 } }
shader *lava3 { stage { map *lava3 } }
shader *lava4 { stage { map *lava4 } }

# ----------------------
# TELEPORTER (star-prefixed)
# ----------------------
shader *teleport
{
    sort additive
    stage {
        map *teleport
        tcmod rotate 25
        rgbgen const 0.8 0.2 1.0
        blend add
        emissive 1
    }
}

# ----------------------
# WATER (animated +0/+1 form)
# Duplicate for WATER2/WATER3 if needed.
# ----------------------
shader +0WATER1
{
    sort additive
    stage {
        animmap 6 +0WATER1 +1WATER1 +2WATER1 +3WATER1
        tcmod scroll 0.02 0.00
        tcmod stretch sin 1 0.08 0 0.4
        tcmod turb 0.025 0.6
        rgbgen const 0.5 0.7 1.0
        blend add
        emissive 1
    }
}
shader +1WATER1 { stage { map +1WATER1 } }
shader +2WATER1 { stage { map +2WATER1 } }
shader +3WATER1 { stage { map +3WATER1 } }

