# ----------------------
# Lights / Panels (common names)
# These may vary per WAD; duplicate & rename as needed.
# ----------------------
shader light1
{
    sort additive
    stage { map light1 }
    stage {
        map light1
        rgbgen const 1 1 0.8
        blend add
        emissive 1
    }
}

shader light2
{
    sort additive
    stage { map light2 }
    stage {
        map light2
        rgbgen const 1 0.9 0.5
        blend add
        emissive 1
    }
}

