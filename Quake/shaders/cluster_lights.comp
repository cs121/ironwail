layout(local_size_x=8, local_size_y=8, local_size_z=1) in;

#include "frame_uniforms.glsl"

// Konstanten
#define LIGHT_TILES_X 32
#define LIGHT_TILES_Y 16
#define LIGHT_TILES_Z 32
#define MAX_LIGHTS    64
#define INV_LIGHT_TILES_X (1.0 / float(LIGHT_TILES_X))
#define INV_LIGHT_TILES_Y (1.0 / float(LIGHT_TILES_Y))

struct Light
{
	vec3	origin;
	float	radius;
	vec3	color;
	float	minlight;
};

layout(std430, binding=0) restrict readonly buffer LightBuffer
{
	float	LightStyles[64];
	Light	Lights[];
};

layout(rg32ui, binding=0) uniform writeonly uimage3D LightClusters;

layout(std140, binding=1) uniform InputUBO
{
	mat4	TransposedProj;
	mat4	View;
	vec2	TileSize;  // Vorberechnete Tile-Größen
};

// Shared Memory für Light-Daten
shared vec4 local_lights[MAX_LIGHTS]; // xyz = view space pos; w = radius²
shared uint light_count;

// Cluster-Daten
struct ClusterData
{
	vec4 planes[6];
	vec3 center;
	vec3 half_size;
};

// Utility-Funktionen
vec3 ApplyFog(vec3 clr, vec3 p)
{
	float fog = exp2(-Fog.w * dot(p, p));
	return mix(Fog.rgb, clr, clamp(fog, 0.0, 1.0));
}

float GetLightStyle(int index)
{
	return (index < 64) ? LightStyles[index] : 1.0;
}

// Optimierte Plane-Extraktion
vec4 ExtractFrustumPlane(int axis, float ndcval, float side)
{
	vec4 plane = TransposedProj[axis] - ndcval * TransposedProj[3];
	return side * plane * inversesqrt(dot(plane.xyz, plane.xyz));
}

// Cluster-Berechnung
ClusterData ComputeCluster(uvec3 gid)
{
	ClusterData cluster;
	
	const float TileSizeX = 2.0 * INV_LIGHT_TILES_X;
	const float TileSizeY = 2.0 * INV_LIGHT_TILES_Y;
	
	float x0 = -1.0 + float(gid.x) * TileSizeX;
	float y0 = -1.0 + float(gid.y) * TileSizeY;
	float z0 = exp2((float(gid.z) - ZLogBias) / ZLogScale);
	float z1 = z0 * exp2(1.0 / ZLogScale);
	
	// Frustum-Planes berechnen
	cluster.planes[0] = ExtractFrustumPlane(0, x0,             -1.0);  // left
	cluster.planes[1] = ExtractFrustumPlane(0, x0 + TileSizeX,  1.0);  // right
	cluster.planes[2] = ExtractFrustumPlane(1, y0,             -1.0);  // bottom
	cluster.planes[3] = ExtractFrustumPlane(1, y0 + TileSizeY,  1.0);  // top
	cluster.planes[4] = vec4(-1.0, 0.0, 0.0,  z0);                     // near
	cluster.planes[5] = vec4( 1.0, 0.0, 0.0, -z1);                     // far
	
	// Cluster-Extents berechnen (AABB)
	vec3 bl = cross(cluster.planes[2].xyz, cluster.planes[0].xyz);
	vec3 tr = cross(cluster.planes[3].xyz, cluster.planes[1].xyz);
	
	vec3 p0 = vec3(z0, (z0 / bl.x) * bl.yz);
	vec3 p1 = vec3(z1, (z1 / bl.x) * bl.yz);
	vec3 p2 = vec3(z0, (z0 / tr.x) * tr.yz);
	vec3 p3 = vec3(z1, (z1 / tr.x) * tr.yz);
	
	vec3 cluster_mins = vec3(z0, min(min(p0.yz, p1.yz), min(p2.yz, p3.yz)));
	vec3 cluster_maxs = vec3(z1, max(max(p0.yz, p1.yz), max(p2.yz, p3.yz)));
	
	cluster.center = (cluster_mins + cluster_maxs) * 0.5;
	cluster.half_size = (cluster_maxs - cluster_mins) * 0.5;
	
	return cluster;
}

// Optimierter Sphere-AABB Test
bool SphereIntersectsAABB(vec3 sphere_center, float radius_sq, vec3 aabb_center, vec3 aabb_half_size)
{
	vec3 delta = max(abs(sphere_center - aabb_center) - aabb_half_size, vec3(0.0));
	return dot(delta, delta) < radius_sq;
}

// Alternative: Sphere-Frustum Test (aktivierbar)
bool SphereIntersectsFrustum(vec3 sphere_center, float radius, vec4 planes[6])
{
	for (int i = 0; i < 6; i++)
	{
		if (dot(sphere_center, planes[i].xyz) + planes[i].w > radius)
			return false;
	}
	return true;
}

void main()
{
	uvec3 gid = gl_GlobalInvocationID;
	uvec3 lid = gl_LocalInvocationID;
	uint local_idx = gl_LocalInvocationIndex;
	
	// Early exit für ungültige Threads
	if (any(greaterThanEqual(gid, uvec3(LIGHT_TILES_X, LIGHT_TILES_Y, LIGHT_TILES_Z))))
		return;
	
	uint numlights = min(NumLights, MAX_LIGHTS);
	
	// Früher Exit wenn keine Lichter
	if (numlights == 0u)
	{
		imageStore(LightClusters, ivec3(gid), uvec4(0u));
		return;
	}
	
	// Lichter in Shared Memory laden (kooperativ)
	uint groupsize = gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;
	uint numpasses = (numlights + groupsize - 1u) / groupsize;
	
	for (uint pass = 0u; pass < numpasses; pass++)
	{
		uint index = local_idx + pass * groupsize;
		if (index < numlights)
		{
			Light l = Lights[index];
			vec3 view_pos = (View * vec4(l.origin, 1.0)).xyz;
			float radius_sq = l.radius * l.radius;
			local_lights[index] = vec4(view_pos, radius_sq);
		}
	}
	
	barrier();
	
	// Cluster-Daten berechnen
	ClusterData cluster = ComputeCluster(gid);
	
	// Light-Culling durchführen
	uint clustermask[MAX_LIGHTS / 32];
	for (uint i = 0u; i < clustermask.length(); i++)
		clustermask[i] = 0u;
	
	// Optimierte Light-Tests
	for (uint i = 0u; i < numlights; i++)
	{
		vec4 light = local_lights[i];
		
		// AABB-Test (schneller als Frustum-Test)
		if (SphereIntersectsAABB(light.xyz, light.w, cluster.center, cluster.half_size))
		{
			// Optional: Zusätzlicher präziser Frustum-Test
			// if (SphereIntersectsFrustum(light.xyz, sqrt(light.w), cluster.planes))
			clustermask[i >> 5u] |= 1u << (i & 31u);
		}
	}
	
	// Ergebnis schreiben
	imageStore(LightClusters, ivec3(gid), uvec4(clustermask[0], clustermask[1], 0u, 0u));
}