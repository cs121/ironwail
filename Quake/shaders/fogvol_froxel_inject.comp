layout(local_size_x=4, local_size_y=4, local_size_z=4) in;

struct FroxelLight
{
	vec4 pos_rad;
	vec4 color_intensity;
	uint type;
	uint pad0;
	uint pad1;
	uint pad2;
};

layout(std430, binding=0) readonly buffer FroxelLightsBuffer
{
	FroxelLight lights[];
};

layout(rgba16f, binding=0) uniform image3D FogFroxelOutTex;
layout(binding=1) uniform sampler3D FogFroxelHistoryTex;

layout(location=0) uniform vec4 FogFroxelDimsAndCount; // xyz dims, w light count
layout(location=1) uniform vec4 FogFroxelParams0; // x near, y far, z tanHalfFovX, w tanHalfFovY
layout(location=2) uniform vec4 FogFroxelParams1; // x log(far/near)
layout(location=3) uniform mat4 FogFroxelInvView;
layout(location=7) uniform vec4 FogFroxelTemporal; // x alpha, y reject threshold, z cameraDelta, w prevValid

vec3 FroxelWorldPos(ivec3 coord, ivec3 dims)
{
	vec3 uvw = (vec3(coord) + vec3(0.5)) / max(vec3(dims), vec3(1.0));
	float nearClip = max(FogFroxelParams0.x, 1e-4);
	float logFarNear = max(FogFroxelParams1.x, 1e-4);
	float z = nearClip * exp(uvw.z * logFarNear);
	float halfW = max(1e-4, z * FogFroxelParams0.z);
	float halfH = max(1e-4, z * FogFroxelParams0.w);
	vec3 viewPos = vec3((uvw.x - 0.5) * (2.0 * halfW), (uvw.y - 0.5) * (2.0 * halfH), -z);
	return (FogFroxelInvView * vec4(viewPos, 1.0)).xyz;
}

void main()
{
	ivec3 dims = max(ivec3(FogFroxelDimsAndCount.xyz), ivec3(1));
	ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
	if (any(greaterThanEqual(coord, dims)))
		return;

	int lightCount = clamp(int(FogFroxelDimsAndCount.w), 0, lights.length());
	vec3 p = FroxelWorldPos(coord, dims);
	vec3 accum = vec3(0.0);

	for (int i = 0; i < lightCount; ++i)
	{
		vec3 delta = lights[i].pos_rad.xyz - p;
		float dist = length(delta);
		float radius = max(lights[i].pos_rad.w, 1e-3);
		float atten = clamp(1.0 - dist / radius, 0.0, 1.0);
		atten *= atten;
		if (atten <= 1e-5)
			continue;
		accum += max(lights[i].color_intensity.rgb, vec3(0.0)) * (max(lights[i].color_intensity.w, 0.0) * atten);
	}

	vec3 uvw = (vec3(coord) + vec3(0.5)) / vec3(dims);
	vec3 history = texture(FogFroxelHistoryTex, uvw).rgb;
	float alpha = clamp(FogFroxelTemporal.x, 0.0, 1.0);
	float rejectThreshold = max(FogFroxelTemporal.y, 1.0);
	float cameraReject = clamp(FogFroxelTemporal.z / rejectThreshold, 0.0, 1.0);
	float prevValid = (FogFroxelTemporal.w > 0.5) ? 1.0 : 0.0;
	float historyWeight = alpha * (1.0 - cameraReject) * prevValid;
	vec3 outRgb = mix(accum, history, clamp(historyWeight, 0.0, 1.0));

	imageStore(FogFroxelOutTex, coord, vec4(outRgb, 1.0));
}
