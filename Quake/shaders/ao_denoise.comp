layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D RawAO;
layout(binding=1) uniform sampler2D DepthTexture;
layout(binding=2) uniform sampler2D EdgeTexture;
layout(r16f, binding=0) uniform writeonly image2D OutAO;
layout(location=0) uniform vec4 u_params0;
layout(location=1) uniform vec4 u_screen;
layout(location=2) uniform vec4 u_depth;
layout(location=3) uniform vec4 u_viewRect;
void main(){
 ivec2 px=ivec2(gl_GlobalInvocationID.xy); ivec2 size=imageSize(OutAO); if(any(greaterThanEqual(px,size))) return;
 vec2 uv=(vec2(px)+0.5)/vec2(size);
 float sigma=max(u_params0.z,0.01); int radius=clamp(int(u_params0.w+0.5),1,4);
 float center=texelFetch(RawAO,px,0).r; float edge=texelFetch(EdgeTexture,px,0).r;
 float sum=0.0, wsum=0.0;
 for(int y=-4;y<=4;y++) for(int x=-4;x<=4;x++){
  if(abs(x)>radius||abs(y)>radius) continue;
  ivec2 sp=clamp(px+ivec2(x,y),ivec2(0),size-ivec2(1));
  float ao=texelFetch(RawAO,sp,0).r; float e=texelFetch(EdgeTexture,sp,0).r;
  float d2=float(x*x+y*y); float w=exp(-d2/(2.0*sigma*sigma));
  w*=mix(1.0,0.25,abs(e-edge));
  sum += ao*w; wsum += w;
 }
 float outAO = (wsum>0.0)?sum/wsum:center;
 imageStore(OutAO,px,vec4(clamp(outAO,0.0,1.0)));
}
