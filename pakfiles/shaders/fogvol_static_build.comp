layout(local_size_x=64) in;

struct FogLightGpu
{
	vec4 pos_rad;
	vec4 col_int;
};

layout(std430, binding=0) readonly buffer StaticRgbBuffer
{
	float rgb[];
};

layout(std430, binding=1) readonly buffer StaticWeightBuffer
{
	float weight[];
};

layout(std430, binding=2) writeonly buffer StaticOutLightBuffer
{
	FogLightGpu lights[];
};

layout(location=0) uniform vec4 BuildParams0; // x total_cells, y stride, z out_count, w nx
layout(location=1) uniform vec4 BuildParams1; // x ny, y nz
layout(location=2) uniform vec4 BuildMins;
layout(location=3) uniform vec4 BuildStepRadius; // xyz cell size, w radius
layout(location=4) uniform vec4 BuildScale; // x color scale

void main()
{
	uint i = gl_GlobalInvocationID.x;
	uint total_cells = uint(max(BuildParams0.x, 0.0));
	uint stride = uint(max(BuildParams0.y, 1.0));
	uint out_count = uint(max(BuildParams0.z, 0.0));
	uint nx = uint(max(BuildParams0.w, 1.0));
	uint ny = uint(max(BuildParams1.x, 1.0));
	uint nxy = nx * ny;
	uint src = i * stride;
	FogLightGpu out_light;

	if (i >= out_count || src >= total_cells)
		return;

	out_light.pos_rad = vec4(0.0);
	out_light.col_int = vec4(0.0);

	if (src < weight.length() && weight[src] > 0.0)
	{
		float w = weight[src];
		uint x = src % nx;
		uint y = (src / nx) % ny;
		uint z = (nxy > 0u) ? (src / nxy) : 0u;
		uint rgb_ofs = src * 3u;
		vec3 c = vec3(0.0);

		if (rgb_ofs + 2u < rgb.length())
		{
			c.x = max(0.0, rgb[rgb_ofs + 0u] / w) * BuildScale.x;
			c.y = max(0.0, rgb[rgb_ofs + 1u] / w) * BuildScale.x;
			c.z = max(0.0, rgb[rgb_ofs + 2u] / w) * BuildScale.x;
		}

		out_light.pos_rad.x = BuildMins.x + (float(x) + 0.5) * BuildStepRadius.x;
		out_light.pos_rad.y = BuildMins.y + (float(y) + 0.5) * BuildStepRadius.y;
		out_light.pos_rad.z = BuildMins.z + (float(z) + 0.5) * BuildStepRadius.z;
		out_light.pos_rad.w = BuildStepRadius.w;
		out_light.col_int = vec4(c, 1.0);
	}

	lights[i] = out_light;
}
